{
	order rate_limit before basicauth
}

:8080 {
	# HTML page: Caddy templates inject base path
	@htmlpage {
		path /
		path /index.html
	}
	handle @htmlpage {
		templates
		root * /app/frontend/dist
		rewrite * /index.html
		file_server
	}

	# Session endpoint: 5 req/min per IP
	handle /api/session {
		rate_limit {
			zone session {
				key {remote_host}
				events 5
				window 1m
			}
		}
		reverse_proxy localhost:{$BACKEND_PORT:8081}
	}

	# API endpoints: 120 req/min per IP
	handle /api/* {
		rate_limit {
			zone api {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy localhost:{$BACKEND_PORT:8081}
	}

	# Health check: proxied to backend (used by Fly.io)
	handle /health {
		reverse_proxy localhost:{$BACKEND_PORT:8081}
	}

	# WebSocket: live transcription progress. Caddy upgrades automatically.
	handle /ws {
		reverse_proxy localhost:{$BACKEND_PORT:8081}
	}

	# Static assets + SPA fallback: unknown paths (e.g. /callback, deep links)
	# fall back to index.html so the React router can handle them instead of 404.
	handle {
		root * /app/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
