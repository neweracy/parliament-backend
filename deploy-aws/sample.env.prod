# =============================================================================
# Production env template — Parliament Hansard System (single-host compose)
# =============================================================================
# These are the values docker-compose.prod.yml expects. In production they are
# generated by env-from-ssm.sh from SSM Parameter Store; this file documents
# the full set and can be used for a manual/offline bring-up.
#
# NEVER commit a filled-in copy. Only this template belongs in git.
# =============================================================================

# --- Public site ---
# A domain enables automatic Let's Encrypt TLS. Use ":80" for IP-only testing.
SITE_ADDRESS=hansard.example.com

# --- Shared internal token (gateway <-> postprocess). Generate a strong random. ---
SERVICE_TOKEN=change-me-strong-random

# --- External API keys ---
DEEPGRAM_API_KEY=change-me
KHAYA_API_KEY=change-me

# --- Gateway session signing (JWT). Generate a strong random. ---
SESSION_SECRET=change-me-strong-random

# --- PostgreSQL (containerised, persisted on EBS) ---
POSTGRES_USER=postprocess
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=postprocess

# --- AWS / Bedrock ---
# Bedrock auth uses the EC2 instance IAM role — do NOT set AWS keys here.
# NOTE: the "us." inference-profile model IDs only resolve in US regions.
# In eu-central-1 use an "eu." profile or a region-native model id.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Auth mode: legacy (JWT via /api/session) or cognito ---
AUTH_MODE=legacy
