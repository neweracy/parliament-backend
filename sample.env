# Required
DEEPGRAM_API_KEY=%api_key%

# Khaya AI (GhanaNLP) ASR
KHAYA_API_KEY=%khaya_api_key%
# ASR version: v1 (fast, single-sentence) or v3 (accurate, long-form). Defaults to v3.
KHAYA_ASR_VERSION=v3

# Hybrid Confidence Transcription pipeline (Deepgram + Khaya AI correction)
# Confidence value below which a Deepgram word is treated as low-confidence and
# sent for correction. Float in [0, 1]. Defaults to 0.85.
HYBRID_CONFIDENCE_THRESHOLD=0.85
# Maximum time gap (seconds) between adjacent low-confidence words for them to be
# grouped into the same correction segment. Float >= 0. Defaults to 0.5.
HYBRID_GAP_TOLERANCE=0.5
# Extra audio duration (seconds) added before and after each segment slice to
# preserve acoustic context for correction. Float >= 0. Defaults to 0.25.
HYBRID_PADDING=0.25
# Maximum Correction_Engine (Khaya) calls per language model per transcription.
# Low-confidence segments are grouped into at most this many batches, so total
# Khaya calls are capped at maxCallsPerModel × 3 languages. Integer >= 1. Defaults to 3.
HYBRID_MAX_CALLS_PER_MODEL=3

# Optional (defaults shown)
# Backend API server port
PORT=8081
# Server host
HOST=0.0.0.0
# Maximum JSON request body size (any value the bytes package accepts, e.g. 256kb, 1mb).
# Defaults to 256kb. POST /api/ask forwards conversation history, so keep this
# comfortably above a 20-message thread. The login route enforces its own 2KB cap.
JSON_BODY_LIMIT=256kb

# Node environment: development, test, demo, or production
NODE_ENV=development

# Authentication mode: legacy (JWT via /api/session) or cognito (AWS Cognito JWTs)
AUTH_MODE=legacy

# Cognito configuration (required when AUTH_MODE=cognito)
# COGNITO_USER_POOL_ID=
# COGNITO_REGION=us-east-1
# COGNITO_APP_CLIENT_ID=
# COGNITO_DOMAIN=

# Bcrypt cost factor for password hashing (12, 13, or 14). Defaults to 12.
# BCRYPT_COST=12

# JWT token lifetime in seconds (1-3600). Defaults to 900.
# JWT_LIFETIME=900

# Session auth (set in production to enable nonce validation)
# SESSION_SECRET=%session_secret%

# PostgreSQL database connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/hansard

# Audio storage path (where uploaded audio files are saved). Defaults to ./uploads/audio.
# AUDIO_STORAGE_PATH=./uploads/audio

# ASR pipeline configuration
# Maximum upload size in bytes. Defaults to 1572864 (1.5 MB).
# ASR_MAX_UPLOAD_BYTES=1572864
# Chunk duration in seconds for splitting large audio files. Defaults to 180.
# ASR_CHUNK_SECONDS=180
# Maximum upload retry attempts per chunk. Defaults to 5.
# ASR_MAX_UPLOAD_ATTEMPTS=5

# Amazon Bedrock (optional — LLM post-processing for improved accuracy)
# Requires access to Anthropic Claude models in your AWS account.
# If not set, the system uses only the rule-based correction engine.
AWS_ACCESS_KEY_ID=%aws_access_key%
AWS_SECRET_ACCESS_KEY=%aws_secret_key%
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Python Postprocessing Service integration
# Mode: js (default, runs JS correction engine inline), python (calls the Python service),
# off (returns raw transcript, no correction)
POSTPROCESS_MODE=python
# Internal URL where the Gateway reaches the Postprocessing Service
POSTPROCESS_URL=http://localhost:8082
# Shared Bearer token for Gateway→Service auth (must match SERVICE_TOKEN on the service)
POSTPROCESS_TOKEN=your-postprocess-token-here
# Circuit breaker: consecutive failures before opening the circuit. Default: 5
POSTPROCESS_BREAKER_THRESHOLD=5
# Circuit breaker: cool-down (ms) before probing a half-open circuit. Default: 30000
POSTPROCESS_BREAKER_COOLDOWN_MS=30000
# Request timeout (ms) for calls to the Postprocessing Service. Default: 20000
POSTPROCESS_TIMEOUT_MS=20000

# Redis connection URL. When not set, caching is disabled (all operations
# return cache-miss results). Supports redis:// and rediss:// (TLS) schemes.
# REDIS_URL=redis://localhost:6379

# Sentry error monitoring (optional — leave blank to disable)
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# Percentage of requests to trace for performance monitoring (0.0–1.0). Default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
