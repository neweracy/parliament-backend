{
  "name": "@deepgram/node-transcription",
  "version": "1.0.0",
  "private": true,
  "description": "Prerecorded audio transcription using Deepgram",
  "main": "server.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "start": "node --no-deprecation server.js",
    "start-backend": "nodemon --no-deprecation server.js",
    "lint": "eslint .",
    "test": "eslint . && node --test 'test/**/*.test.js'",
    "test:khaya:live": "node scripts/test-khaya-live.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepgram-starters/node-transcription.git"
  },
  "keywords": [
    "speech-to-text",
    "deepgram",
    "transcription",
    "audio-transcription"
  ],
  "author": "Deepgram DX Team <devrel@deepgram.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/deepgram-starters/node-transcription/issues"
  },
  "homepage": "https://github.com/deepgram-starters/node-transcription#readme",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.750.0",
    "@deepgram/sdk": "4.11.3",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "ffmpeg-static": "5.3.0",
    "ghana-locations": "1.1.4",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "^4.1.0",
    "multer": "2.0.2",
    "pg": "^8.22.0",
    "swagger-ui-express": "5.0.1",
    "toml": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "eslint": "9.39.0",
    "fast-check": "4.8.0",
    "nodemon": "3.1.10",
    "supertest": "7.2.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}