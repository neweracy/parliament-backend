deploy-aws/_cognito-policy.json
# Build/transfer artifacts — never commit
deploy-aws/*.tar
deploy-aws/*.tar.gz
deploy-aws/chunks/
deploy-aws/chunks2/
deploy-aws/*.log
deploy-aws/_*.txt

# Stray nested umbrella clone added during deployment work — not part of this
