{
  "family": "postprocess-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/postprocess-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/postprocess-task-role",
  "containerDefinitions": [
    {
      "name": "postprocess",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/postprocess-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8082,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PORT", "value": "8082" },
        { "name": "UVICORN_WORKERS", "value": "2" },
        { "name": "DRAIN_TIMEOUT_SECONDS", "value": "15" },
        { "name": "AWS_REGION", "value": "${AWS_REGION}" },
        { "name": "BEDROCK_MODEL_ID", "value": "us.anthropic.claude-haiku-4-5-20251001-v1:0" },
        { "name": "LLM_ENABLED", "value": "true" },
        { "name": "DATASET_REFRESH_SECONDS", "value": "300" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "DB_POOL_SIZE", "value": "5" },
        { "name": "DB_MAX_OVERFLOW", "value": "5" },
        { "name": "DB_POOL_RECYCLE_SECONDS", "value": "1800" },
        { "name": "DB_POOL_TIMEOUT_SECONDS", "value": "10" },
        { "name": "DB_CONNECT_TIMEOUT_SECONDS", "value": "10" },
        { "name": "DB_STATEMENT_TIMEOUT_MS", "value": "15000" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "HISTORY_QUEUE_SIZE", "value": "1000" },
        { "name": "HISTORY_RETENTION_DAYS", "value": "90" },
        { "name": "HISTORY_RETENTION_INTERVAL_SECONDS", "value": "86400" },
        { "name": "RUN_MIGRATIONS", "value": "false" }
      ],
      "secrets": [
        {
          "name": "SERVICE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:postprocess/service-token"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:postprocess/database-url"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -sf http://localhost:8082/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "_comment_healthCheck": "Container health uses /health (liveness) so a transient database outage does not trigger a restart loop while corrections still serve from the cached snapshot. Point the LOAD BALANCER target group at /ready instead, which also verifies live database connectivity and returns 503 when the database is unreachable.",
      "_comment_migrations": "RUN_MIGRATIONS=false: schema changes run as a separate one-off task or pipeline step, not on every task start. Concurrent tasks racing 'alembic upgrade head' during a scale-out or rolling deploy is not safe.",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/postprocess-service",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "postprocess"
        }
      },
      "stopTimeout": 15
    }
  ]
}
