# =============================================================================
# Postprocessing Service — Environment Configuration
# =============================================================================
# Copy this file to .env for local development. In production, inject values
# via secrets management (e.g. AWS Secrets Manager) — never commit real secrets.

# -----------------------------------------------------------------------------
# Required secrets (service will exit non-zero if absent)
# -----------------------------------------------------------------------------

# Shared token the Gateway presents to authenticate internal requests.
# Must match the POSTPROCESS_TOKEN configured on the Gateway side.
SERVICE_TOKEN=your-service-token-here

# PostgreSQL connection string for the Dataset_Store.
# Format: postgresql+psycopg://user:password@host:port/dbname
# The postgresql:// and postgres:// forms are accepted and rewritten to psycopg.
DATABASE_URL=postgresql+psycopg://postprocess:your-db-password-here@localhost:5432/postprocess

# -----------------------------------------------------------------------------
# Database connection pool
# -----------------------------------------------------------------------------
# One shared pool serves the dataset cache, pg_trgm retrieval, and history writes.
# Peak server-side connections per instance = DB_POOL_SIZE + DB_MAX_OVERFLOW.
# Multiply by your instance count and keep it comfortably under the server's
# max_connections (100 by default on stock PostgreSQL).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Retire pooled connections after this many seconds. Must be LOWER than any
# upstream idle timeout (RDS Proxy, PgBouncer, NAT gateway) or those components
# will close connections while the pool still believes they are usable.
DB_POOL_RECYCLE_SECONDS=1800

# Seconds a caller waits for a free pool slot before erroring. Bounded so pool
# exhaustion fails fast instead of hanging the request.
DB_POOL_TIMEOUT_SECONDS=10

# Seconds to wait for TCP connection establishment.
DB_CONNECT_TIMEOUT_SECONDS=10

# Server-side per-connection statement timeout (ms). Stops a runaway query from
# occupying a pool slot indefinitely.
DB_STATEMENT_TIMEOUT_MS=15000

# TLS mode. REQUIRED for managed PostgreSQL (RDS, Cloud SQL, Azure) — without it
# credentials and transcript data cross the network in plaintext.
# Leave unset for local Docker. Set to "require", or "verify-full" with a CA bundle.
# Ignored when DATABASE_URL already contains an sslmode parameter.
# DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Bind address. Default: 0.0.0.0 (all interfaces, internal network only)
HOST=0.0.0.0

# HTTP port exposed by the service. Default: 8082
PORT=8082

# Number of Uvicorn worker processes. Size to the task's vCPU count. Default: 2
UVICORN_WORKERS=2

# Seconds to wait for in-flight requests to complete on shutdown. Default: 15
DRAIN_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Dataset_Cache
# -----------------------------------------------------------------------------

# Interval (seconds) between automatic Dataset_Store refreshes. Default: 300
DATASET_REFRESH_SECONDS=300

# Retry interval (seconds) when the initial dataset load fails at startup. Default: 30
DATASET_LOAD_RETRY_SECONDS=30

# -----------------------------------------------------------------------------
# Correction thresholds
# -----------------------------------------------------------------------------

# Minimum confidence score for a Word to be considered a correction candidate.
# Float in [0.0, 1.0]. Default: 0.75
MIN_CONFIDENCE=0.75

# Minimum match confidence for a word-level correction to be accepted.
# Float in [0.0, 1.0]. Default: 0.90
WORD_ACCEPT_THRESHOLD=0.90

# Minimum rapidfuzz similarity score for fuzzy matching.
# Float in [0.0, 1.0]. Default: 0.70
FUZZY_SCORE_CUTOFF=0.70

# Minimum character length for a token to be treated as a correction candidate.
# Tokens shorter than this try only exact and fused strategies. Default: 4
MIN_CANDIDATE_LENGTH=4

# -----------------------------------------------------------------------------
# AWS / Amazon Bedrock (optional — LLM refinement)
# -----------------------------------------------------------------------------

# AWS region for Bedrock API calls. Default: us-east-1
AWS_REGION=us-east-1

# Bedrock model identifier (cross-region inference profile). Default shown below.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS credentials are resolved via the default boto3 credential chain.
# For local development, set these. In production, use an IAM task role instead.
# AWS_ACCESS_KEY_ID=your-aws-access-key-here
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here

# -----------------------------------------------------------------------------
# LLM Refiner
# -----------------------------------------------------------------------------

# Enable or disable the LLM refinement stage. Default: true
LLM_ENABLED=true

# Approximate number of words per LLM chunk. Default: 300
LLM_CHUNK_SIZE=300

# Maximum concurrent Bedrock invocations per wave. Default: 3
LLM_MAX_PARALLEL=3

# Per-chunk timeout in milliseconds before discarding an LLM response. Default: 15000
LLM_CHUNK_TIMEOUT_MS=15000

# Retrieval mode for entity context in LLM prompts.
# "dataset_store" uses pg_trgm similarity queries against the Dataset_Store.
# "knowledge_base" uses an Amazon Bedrock Knowledge Base (set KNOWLEDGE_BASE_ID).
# Default: dataset_store
LLM_RETRIEVAL_MODE=dataset_store

# Maximum entity records injected into each LLM prompt. Default: 50
LLM_MAX_PROMPT_RECORDS=50

# Bedrock Knowledge Base ID (required when LLM_RETRIEVAL_MODE=knowledge_base).
# KNOWLEDGE_BASE_ID=your-knowledge-base-id-here

# -----------------------------------------------------------------------------
# Correction history
# -----------------------------------------------------------------------------

# Enable persistence of applied corrections for future NER training data. Default: true
HISTORY_ENABLED=true

# Bounded in-memory queue for async history writes. On overflow, records are
# dropped (never blocking the request path) and logged at WARNING with the
# postprocess.history_dropped metric. Alarm on that metric: a non-zero value
# means audit data is being lost.
HISTORY_QUEUE_SIZE=1000

# Retention window. correction_history gains a row per applied correction, so
# without pruning it grows without bound and degrades queries and backups.
# A background sweeper deletes rows older than this. Set to 0 to disable.
HISTORY_RETENTION_DAYS=90

# How often the retention sweeper runs (seconds). Default: 86400 (daily)
HISTORY_RETENTION_INTERVAL_SECONDS=86400

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Minimum log level. One of: debug, info, warning, error. Default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Feature flag (read by the Gateway, documented here for awareness)
# -----------------------------------------------------------------------------

# Post-processing mode: js | python | off. Default: js
# The Gateway reads this to decide whether to call the Python service.
# POSTPROCESS_MODE=js

# -----------------------------------------------------------------------------
# Sentry error monitoring (optional — leave blank to disable)
# -----------------------------------------------------------------------------

# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=

# Environment tag for Sentry events (e.g. development, staging, production)
SENTRY_ENVIRONMENT=development

# Release tag for Sentry events (defaults to postprocess@0.1.0)
# SENTRY_RELEASE=postprocess@0.1.0

# Percentage of requests to trace for performance monitoring (0.0–1.0). Default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
